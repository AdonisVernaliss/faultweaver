# Compose example; native development defaults to data/faultweaver.db.
# Native Python does not automatically load this file: export variables explicitly.
FAULTWEAVER_DATABASE_URL=sqlite:////data/faultweaver.db
# Explicit origins only, no wildcard, paths, credentials, query or fragment.
FAULTWEAVER_ALLOWED_ORIGINS=http://localhost:5173
FAULTWEAVER_KEY_PROVIDER=file
# Path only, never paste a key here. Generate outside the repository/data volume.
FAULTWEAVER_MASTER_KEY_FILE=/absolute/private/faultweaver-keys/master.json
